<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Гальштат & Зальцбург — Тур</title>
<style>
  :root{
    --accent:#18b7ea;
    --dark:#02102a;
    --muted:#6b7280;
    --card-bg:#fff;
    --radius:14px;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;background:#f7f8fb;color:#081028;line-height:1.45}
  .container{max-width:1100px;margin:0 auto;padding:24px}
  /* Hero */
  .hero{
    display:grid;
    grid-template-columns: 1fr 380px;
    gap:24px;
    align-items:start;
    margin-top:18px;
  }
  .hero-card{
    background:linear-gradient(180deg, rgba(0,0,0,0.3), rgba(0,0,0,0.1)), url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1600&q=60') center/cover no-repeat;
    color:#fff;
    padding:40px;
    border-radius:18px;
    min-height:320px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    box-shadow:0 10px 30px rgba(6,18,44,0.12)
  }
  .hero h1{font-size:36px;margin:0 0 8px;letter-spacing:0.2px}
  .hero p.lead{margin:0 0 18px;color:rgba(255,255,255,0.92)}
  .btn-primary{
    background:var(--accent);
    color:#fff;
    padding:12px 18px;
    border-radius:12px;
    text-decoration:none;
    display:inline-block;
    font-weight:600;
    box-shadow:0 8px 18px rgba(24,183,234,0.18);
  }
  /* Booking card */
  .booking{
    background:var(--card-bg);
    border-radius:16px;
    padding:18px;
    box-shadow:0 6px 20px rgba(5,12,30,0.06);
    position:sticky;
    top:20px;
    height:fit-content;
  }
  .price{
    display:flex;align-items:center;gap:12px;margin-bottom:12px;
  }
  .price .big{font-size:28px;font-weight:800}
  .price .old{font-size:14px;text-decoration:line-through;color:var(--muted)}
  .small-muted{color:var(--muted);font-size:14px}
  form label{display:block;font-size:13px;margin:8px 0 6px}
  input, select{width:100%;padding:10px;border-radius:10px;border:1px solid #e6e9ef}
  .actions{display:flex;gap:10px;margin-top:12px}
  .actions .btn{flex:1;padding:10px;border-radius:10px;border:0;font-weight:700}
  .btn-pay{background:var(--accent);color:#fff}
  .btn-deposit{background:#f3f6f9;color:var(--dark)}
  /* Sections */
  section{margin:30px 0;padding:18px;border-radius:12px;background:#fff;box-shadow:0 6px 20px rgba(6,18,44,0.03)}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .grid img{width:100%;height:180px;object-fit:cover;border-radius:10px}
  ul.features{padding-left:18px}
  footer{margin:30px 0;text-align:center;color:var(--muted);font-size:14px}
  /* responsive */
  @media (max-width:980px){
    .hero{grid-template-columns:1fr}
    .grid{grid-template-columns:repeat(2,1fr)}
    .hero-card{min-height:260px}
  }
  @media (max-width:560px){
    .grid{grid-template-columns:1fr}
  }
</style>
</head>
<body>
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <div><strong>Kover Travel</strong></div>
      <nav style="color:var(--muted)"><a href="#" style="margin-left:12px;color:var(--muted);text-decoration:none">Главная</a></nav>
    </div>

    <div class="hero" aria-label="Hero">
      <div class="hero-card" role="region" aria-label="Описание поездки">
        <div>
          <div style="font-size:13px;opacity:0.95">6 декабря — однодневный тур</div>
          <h1>Гальштат &amp; Зальцбург</h1>
          <p class="lead">Отправляемся в зимнюю сказку Австрии: экскурсии, рождественские ярмарки и уютные виды.</p>
        </div>
        <div style="margin-top:12px">
          <a class="btn-primary" href="#booking">Забронировать</a>
        </div>
      </div>

      <aside class="booking" id="booking" aria-labelledby="booking-title">
        <div id="booking-title" style="font-weight:700;margin-bottom:8px">Забронировать поездку</div>

        <div class="price">
          <div><span class="big">1 890 Kč</span> <div class="small-muted">/чел</div></div>
          <div style="margin-left:auto;text-align:right">
            <div class="old">1 990 Kč</div>
            <div class="small-muted">Залог 500 Kč</div>
          </div>
        </div>

        <form onsubmit="event.preventDefault(); alert('Форма отправлена — это прототип. Пример: собрать данные и отправить на сервер');">
          <label for="name">Имя и фамилия (латиницей)</label>
          <input id="name" required placeholder="Ivan Ivanov" />

          <label for="email">Email</label>
          <input id="email" type="email" required placeholder="you@example.com" />

          <label for="phone">Телефон</label>
          <input id="phone" placeholder="+420 123 456 789" />

          <label for="count">Количество участников</label>
          <select id="count">
            <option>1</option><option>2</option><option>3</option><option>4</option>
          </select>

          <div style="margin-top:10px" class="small-muted">Оплата: полная стоимость или залог</div>
          <div class="actions">
            <button class="btn btn-pay" type="submit">Оплатить</button>
            <button class="btn btn-deposit" type="button" onclick="alert('Оплата залога — пример')">Внести залог</button>
          </div>
        </form>

        <div style="margin-top:12px" class="small-muted">После оплаты мы добавим тебя в Telegram-чат тура.</div>
      </aside>
    </div>

    <section>
      <h3>Программа</h3>
      <p class="small-muted">Выезд из Праги в 5:00, экскурсия по Гальштату до обеда, затем переезд в Зальцбург, возвращение около 01:00.</p>
    </section>

    <section>
      <h3>Что включено</h3>
      <ul class="features">
        <li>Трансфер с розетками, Wi-Fi и туалетом</li>
        <li>Напитки и лёгкий завтрак в пути</li>
        <li>Экскурсия и сопровождение</li>
        <li>Профессиональная фотосессия</li>
      </ul>
    </section>

    <section>
      <h3>Галерея</h3>
      <div class="grid" aria-hidden="false">
        <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60" alt="Город зимой" />
        <img src="https://images.unsplash.com/photo-1504198453319-5ce911bafcde?auto=format&fit=crop&w=800&q=60" alt="Рождественская ярмарка" />
        <img src="https://images.unsplash.com/photo-1526772662000-3f88f10405ff?auto=format&fit=crop&w=800&q=60" alt="Пейзаж" />
      </div>
    </section>

    <footer>
      KOVER Travel • Politických vězňů 911/8, Praha • <span class="small-muted">IC: 17507588</span>
    </footer>
  </div>

<script>
  // Небольшой JS — показать данные формы в консоли (для примера)
  document.querySelector('form').addEventListener('submit', function(e){
    e.preventDefault();
    const data = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      count: document.getElementById('count').value
    };
    console.log('Booking data:', data);
    alert('Спасибо! Данные в консоли (это шаблон).');
  });
</script>
</body>
</html>
